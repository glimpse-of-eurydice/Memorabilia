{
  "name": "memorabilia",
  "version": "0.1.0",
  "private": true,
  "description": "An experimental sandbox for history-sensitive artificial development.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "preflight": "tsc && node dist/case-study/thought-space-v0/preflight-cli.js",
    "demo": "tsc && node dist/case-study/thought-space-v0/demo-cli.js",
    "run": "tsc && node dist/case-study/thought-space-v0/run-cli.js",
    "view": "tsc && node dist/case-study/thought-space-v0/view-cli.js",
    "test": "tsc && node --test dist/tests/*.test.js dist/case-study/thought-space-v0/*.test.js dist/workbench/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
